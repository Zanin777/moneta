{
  "name": "moneta",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "node scripts/simple-dev.mjs",
    "start": "node --experimental-strip-types backend/index.ts",
    "build": "tsc -p tsconfig.simple.json && vite build --config vite.simple.config.ts",
    "typecheck": "tsc -p tsconfig.simple.json",
    "lint": "eslint frontend backend shared e2e *.simple.* *config.ts",
    "test": "vitest run --config vitest.frontend.config.ts && vitest run --config vitest.backend.config.ts",
    "test:coverage": "vitest run --config vitest.frontend.config.ts --coverage && vitest run --config vitest.backend.config.ts --coverage",
    "test:e2e": "playwright test",
    "dev:legacy": "node scripts/dev.mjs",
    "start:legacy": "node server/index.mjs",
    "build:legacy": "tsc --noEmit && vite build",
    "preview:legacy": "node server/index.mjs",
    "test:legacy": "vitest run --config vitest.legacy.config.ts && node --test server/*.test.mjs",
    "typecheck:legacy": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^18.0.8",
    "lucide-react": "1.57.0",
    "motion": "14.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
